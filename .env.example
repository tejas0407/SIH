# ---------- Postgres / PostGIS ----------
POSTGRES_USER=dilrmp
POSTGRES_PASSWORD=dilrmp_dev_password
POSTGRES_DB=land_records
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
HITL_QUEUE_KEY=hitl:review:queue

# ---------- MinIO (S3-compatible object store) ----------
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_RAW=raw-scans
MINIO_BUCKET_TILES=processed-tiles
MINIO_BUCKET_CERTS=signed-certificates

# ---------- Application ----------
APP_ENV=development
API_V1_PREFIX=/api/v1
AUTO_COMMIT_THRESHOLD=0.85
AREA_TOLERANCE_SQM=0.005
SHARE_TOLERANCE_PCT=0.01
AADHAAR_HASH_SALT=change-me-in-production
OCR_LANGUAGES=hi,mr,en
TROCR_MODEL=microsoft/trocr-base-handwritten
OFFLINE_MODE=true

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
