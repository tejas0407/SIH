# Root .dockerignore — applies to builds whose context is the repo root, i.e.
# deploy/all-in-one/Dockerfile (backend/ and frontend/ have their own).
# Without it, every build ships the full .git history and both dependency trees
# to the builder before a single COPY runs.

.git/
.gitignore
.github/

**/__pycache__/
**/*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
backend/.venv/
backend/venv/
backend/.data/
backend/tests/

frontend/node_modules/
frontend/.next/
frontend/out/
frontend/npm-debug.log*

.env
.env.local
*.pem
*.key

*.log
.DS_Store
pgdata/

docs/
README.md
